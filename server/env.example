# Copy this file to .env and fill in real values. Never commit .env.

# ── Server ──────────────────────────────
PORT=3000

# ── PostgreSQL ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chrishaircut
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── Auth ────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Gmail (Nodemailer transactional email) ──
# Use a Google Workspace/Gmail account with an App Password, not your normal password.
GMAIL_USER=you@gmail.com
GMAIL_PASS=your_app_password

# ── Google Calendar API ─────────────────
# From a Google Cloud project with the Calendar API enabled (OAuth 2.0 client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=